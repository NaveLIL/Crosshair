# Keep Unix build scripts usable after a Windows checkout.
*.sh text eol=lf
*.py text eol=lf
*.rs text eol=lf
*.S text eol=lf
*.ld text eol=lf
# Markdown uses intentional two-space line breaks in the source documentation.
*.md text eol=lf whitespace=-blank-at-eol
# UART evidence is byte-exact CRLF emitted by the guest.
reports/**/qemu-uart.log -text whitespace=cr-at-eol
crosshair-emulator/evidence/**/qemu-uart.log -text whitespace=cr-at-eol
# Preserve the actual tool output's trailing blank lines in Wave005 evidence.
reports/wave005/crypto/compile.log whitespace=-blank-at-eof
reports/wave005/image/policy-host-tests.log whitespace=-blank-at-eof
